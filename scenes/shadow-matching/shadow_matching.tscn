[sub_resource type="Shader" id="Shader_grid"]
code = "shader_type canvas_item;
void fragment() {
	vec2 uv = UV * vec2(46.0, 32.0);
	vec2 g = abs(fract(uv - 0.5) - 0.5) / fwidth(uv);
	float line = 1.0 - min(min(g.x, g.y), 1.0);
	COLOR = mix(vec4(0.937, 0.945, 0.965, 1.0), vec4(0.71, 0.78, 0.87, 1.0), line * 0.6);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_grid"]
shader = SubResource("Shader_grid")

[sub_resource type="Shader" id="Shader_shadow"]
code = "shader_type canvas_item;
void fragment() {
	COLOR = vec4(0.0, 0.0, 0.0, texture(TEXTURE, UV).a * 0.75);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_shadow"]
